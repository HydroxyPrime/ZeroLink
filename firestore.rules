rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isParticipant(chatId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    // Users can read any profile (needed for search + chat headers),
    // but can only create/update their own document.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // Chats: only the two participants can read/write the chat doc,
    // and only participants can read/send messages inside it.
    match /chats/{chatId} {
      allow read: if isParticipant(chatId);
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if isParticipant(chatId);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isParticipant(chatId);
        allow create: if isParticipant(chatId) &&
                       request.resource.data.senderId == request.auth.uid;
        allow update: if isParticipant(chatId); // needed for isRead flips
        allow delete: if false;
      }
    }
  }
}
