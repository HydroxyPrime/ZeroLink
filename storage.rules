rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    match /chat_images/{chatId}/{fileName} {
      // Anyone signed in and part of the chat can read/write.
      // (Client already restricts via app logic; tighten further with
      // a Firestore lookup if you need server-side chat membership checks.)
      allow read, write: if request.auth != null;
    }

    match /profile_photos/{userId}.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
